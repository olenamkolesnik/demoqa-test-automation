# Copy this file to .env for local runs:  cp .env.example .env
# .env is gitignored — never commit real values.

# Base URL of the system under test. Required; the suite fails fast without it.
BASE_URL=https://demoqa.com

# Set to the literal string "true" to log request/response bodies (secrets redacted).
# Any other value, including "false", leaves debug logging off.
DEBUG=false
